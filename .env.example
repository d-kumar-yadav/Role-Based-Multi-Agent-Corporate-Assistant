

# ---- LLM Models (Groq) ----
MODEL=openai/gpt-oss-20b
FIREWALL_MODEL=openai/gpt-oss-20b
ROUTER_MODEL=openai/gpt-oss-20b

# ---- API Keys ----
GROQ_API_KEY=your-groq-key
FIREWALL_GROQ_API_KEY=your-firewall-groq-key

# ---- LangSmith Tracing (optional) ----
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-key
LANGSMITH_PROJECT=meridian-copilot

# ---- Auth ----
JWT_SECRET=change-me-to-a-32-byte-random-hex-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ---- Qdrant Vector Store ----
# Option A — Qdrant Cloud (recommended for deployment)
QDRANT_URL=
QDRANT_API_KEY=

# Option B — Docker Compose local Qdrant
# QDRANT_URL=http://qdrant:6333

# ---- Model Cache ----
HF_HOME=/app/.cache/huggingface

# ---- Runtime ----
ENV=dev
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1